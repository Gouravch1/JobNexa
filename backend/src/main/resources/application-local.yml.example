# Copy this file to application-local.yml and fill in your real values.
# application-local.yml is gitignored and will NOT be pushed to GitHub.

spring:
  datasource:
    username: root
    password: your-mysql-password-here

jwt:
  secret: your-jwt-secret-at-least-256-bits-long-for-hs256

elevenlabs:
  api:
    key: your-elevenlabs-api-key-here
    # voice-id: optional-override

